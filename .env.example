# Use development for local XAMPP/HTTP. Use production only on HTTPS hosts.
CI_ENVIRONMENT = production
app.baseURL = 'https://your-domain.example/'

workspace.databaseDriver = mysql
database.default.hostname = 127.0.0.1
database.default.port = 3306
database.default.database = orbit_ticketing
# Production refuses root and empty passwords — create a dedicated MySQL user.
database.default.username = orbit_app
database.default.password = 'replace-with-a-strong-password'
database.default.DBDriver = MySQLi

# REQUIRED in production before the first database access (creates the owner account).
workspace.ownerEmail = 'you@example.com'
workspace.ownerPassword = 'choose-a-long-unique-password'

# Local development tip: set CI_ENVIRONMENT = development so demo seed and HTTP work.
# XAMPP may use database.default.username = root with an empty password only in development.

# SQLite fallback: set workspace.databaseDriver = sqlite.
# Optional SQLite source path for migration; default: writable/workspace.sqlite
# workspace.databasePath = 'C:/path/to/workspace.sqlite'
